{
  "name": "codewalk-reader",
  "displayName": "CodeWalk Reader",
  "description": "%extension.description%",
  "version": "0.1.1",
  "publisher": "properworkstudio",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/properwork-studio/codewalk.git"
  },
  "bugs": {
    "url": "https://github.com/properwork-studio/codewalk/issues"
  },
  "homepage": "https://github.com/properwork-studio/codewalk#readme",
  "sponsor": {
    "url": "https://ko-fi.com/properworkstudio"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "%extension.untrustedWorkspaces.description%"
    }
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Education",
    "Visualization"
  ],
  "keywords": [
    "codebase",
    "onboarding",
    "code tour",
    "walkthrough",
    "code reading"
  ],
  "icon": "resources/icon-128.png",
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codewalk",
          "title": "CodeWalk",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "codewalk": [
        {
          "id": "codewalk.playerView",
          "name": "Walk",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "codewalk.openWalk",
        "title": "%command.openWalk.title%",
        "category": "CodeWalk"
      },
      {
        "command": "codewalk.nextStep",
        "title": "%command.nextStep.title%",
        "category": "CodeWalk"
      },
      {
        "command": "codewalk.prevStep",
        "title": "%command.prevStep.title%",
        "category": "CodeWalk"
      },
      {
        "command": "codewalk.revealCurrentStep",
        "title": "%command.revealCurrentStep.title%",
        "category": "CodeWalk"
      }
    ]
  },
  "scripts": {
    "watch": "node esbuild.js --watch",
    "build": "node esbuild.js",
    "vscode:prepublish": "node esbuild.js --production",
    "package": "vsce package --no-dependencies --out codewalk.vsix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"{src,shared,ui}/**/*.ts\" \"*.js\"",
    "format:check": "prettier --check \"{src,shared,ui}/**/*.ts\" \"*.js\"",
    "relocate-anchors": "node scripts/relocate-anchors.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "1.90.0",
    "@vscode/codicons": "0.0.46-24",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.24.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@shikijs/langs": "^4.4.1",
    "@shikijs/themes": "^4.4.1",
    "marked": "^18.0.7",
    "shiki": "^4.4.1"
  }
}
